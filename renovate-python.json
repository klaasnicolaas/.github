{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared dependency policy for personal Python packages",
  "extends": [
    "github>klaasnicolaas/.github:renovate-base"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "poetry",
        "pep621"
      ],
      "addLabels": [
        "python"
      ]
    },
    {
      "matchManagers": [
        "poetry",
        "pep621"
      ],
      "matchDepTypes": [
        "dev"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "poetry",
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
